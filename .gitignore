# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Scratch & temporary development folders
scratch/
graphify-out/

# Video inputs (keep folder structure via .gitkeep, ignore video files)
video input/*
!video input/.gitkeep

# Video outputs (keep folder structure via .gitkeep, ignore generated videos/datasets)
video output/*
!video output/.gitkeep

# PyTorch weight checkpoints (>100MB / not used in ONNX runtime)
*.pt

# OS & Editor generated files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
